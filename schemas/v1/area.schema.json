{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ppp2048/geoproduct-engineer-skill/main/schemas/v1/area.schema.json",
  "$defs": {
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "Rings of positions: the first is the outer ring, any others are holes.",
      "properties": {
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Where to look. Give exactly one of ``bbox``, ``polygon``, or ``point`` with ``radius_m``.",
  "properties": {
    "name": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "bbox": {
      "anyOf": [
        {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            },
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Bbox"
    },
    "polygon": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Polygon"
    },
    "point": {
      "anyOf": [
        {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "maximum": 180.0,
              "minimum": -180.0,
              "type": "number"
            },
            {
              "maximum": 90.0,
              "minimum": -90.0,
              "type": "number"
            }
          ],
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Point"
    },
    "radius_m": {
      "anyOf": [
        {
          "exclusiveMinimum": 0,
          "maximum": 50000,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Radius M"
    }
  },
  "title": "Area",
  "type": "object"
}
