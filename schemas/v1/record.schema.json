{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ppp2048/geoproduct-engineer-skill/main/schemas/v1/record.schema.json",
  "$defs": {
    "Address": {
      "additionalProperties": false,
      "properties": {
        "full": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Full"
        },
        "house_number": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "House Number"
        },
        "street": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Street"
        },
        "locality": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locality"
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "postcode": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Postcode"
        },
        "country_code": {
          "anyOf": [
            {
              "pattern": "^[A-Z]{2}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Country Code"
        }
      },
      "title": "Address",
      "type": "object"
    },
    "AttributeValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "basis": {
          "$ref": "#/$defs/Basis",
          "default": "fact"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "title": "AttributeValue",
      "type": "object"
    },
    "Basis": {
      "enum": [
        "fact",
        "estimate",
        "inference"
      ],
      "title": "Basis",
      "type": "string"
    },
    "BuildingCandidate": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "$ref": "#/$defs/BuildingRef"
        },
        "distance_m": {
          "minimum": 0,
          "title": "Distance M",
          "type": "number"
        },
        "contains_point": {
          "title": "Contains Point",
          "type": "boolean"
        },
        "name_similarity": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Name Similarity"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "ref",
        "distance_m",
        "contains_point",
        "score"
      ],
      "title": "BuildingCandidate",
      "type": "object"
    },
    "BuildingMatch": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/MatchStatus"
        },
        "building_ref": {
          "anyOf": [
            {
              "$ref": "#/$defs/BuildingRef"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "method": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Method",
          "type": "string"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "reasons": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        },
        "candidates": {
          "items": {
            "$ref": "#/$defs/BuildingCandidate"
          },
          "title": "Candidates",
          "type": "array"
        }
      },
      "required": [
        "status",
        "method",
        "reasons"
      ],
      "title": "BuildingMatch",
      "type": "object"
    },
    "BuildingRef": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Provider",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "provider",
        "id"
      ],
      "title": "BuildingRef",
      "type": "object"
    },
    "Confidence": {
      "additionalProperties": false,
      "properties": {
        "level": {
          "$ref": "#/$defs/ConfidenceLevel"
        },
        "score": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Score"
        },
        "reasons": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "level"
      ],
      "title": "Confidence",
      "type": "object"
    },
    "ConfidenceLevel": {
      "enum": [
        "high",
        "medium",
        "low",
        "unresolved"
      ],
      "title": "ConfidenceLevel",
      "type": "string"
    },
    "Conflict": {
      "additionalProperties": false,
      "description": "Sources disagree about one field. Values are kept side by side, never overwritten.",
      "properties": {
        "field": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Field",
          "type": "string"
        },
        "values": {
          "items": {
            "$ref": "#/$defs/ConflictingValue"
          },
          "minItems": 2,
          "title": "Values",
          "type": "array"
        },
        "note": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Note"
        }
      },
      "required": [
        "field",
        "values"
      ],
      "title": "Conflict",
      "type": "object"
    },
    "ConflictingValue": {
      "additionalProperties": false,
      "properties": {
        "value": {
          "$ref": "#/$defs/JsonValue",
          "default": null
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "title": "ConflictingValue",
      "type": "object"
    },
    "GeometryCollection": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "GeometryCollection",
          "default": "GeometryCollection",
          "title": "Type",
          "type": "string"
        },
        "geometries": {
          "items": {
            "discriminator": {
              "mapping": {
                "GeometryCollection": "#/$defs/GeometryCollection",
                "LineString": "#/$defs/LineString",
                "MultiLineString": "#/$defs/MultiLineString",
                "MultiPoint": "#/$defs/MultiPoint",
                "MultiPolygon": "#/$defs/MultiPolygon",
                "Point": "#/$defs/Point",
                "Polygon": "#/$defs/Polygon"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/Point"
              },
              {
                "$ref": "#/$defs/MultiPoint"
              },
              {
                "$ref": "#/$defs/LineString"
              },
              {
                "$ref": "#/$defs/MultiLineString"
              },
              {
                "$ref": "#/$defs/Polygon"
              },
              {
                "$ref": "#/$defs/MultiPolygon"
              },
              {
                "$ref": "#/$defs/GeometryCollection"
              }
            ]
          },
          "title": "Geometries",
          "type": "array"
        }
      },
      "required": [
        "geometries"
      ],
      "title": "GeometryCollection",
      "type": "object"
    },
    "JsonValue": {},
    "LineString": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "LineString",
          "default": "LineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "LineString",
      "type": "object"
    },
    "Location": {
      "additionalProperties": false,
      "description": "What the geometry represents and how precise it is.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/LocationKind",
          "default": "unknown"
        },
        "precision_m": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Precision M"
        },
        "method": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "evidence_ids": {
          "items": {
            "maxLength": 200,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
            "type": "string"
          },
          "title": "Evidence Ids",
          "type": "array"
        }
      },
      "title": "Location",
      "type": "object"
    },
    "LocationKind": {
      "enum": [
        "building_footprint",
        "entrance",
        "address_point",
        "centroid",
        "approximate",
        "unknown"
      ],
      "title": "LocationKind",
      "type": "string"
    },
    "MatchStatus": {
      "enum": [
        "exact",
        "probable",
        "ambiguous",
        "approximate_point",
        "none"
      ],
      "title": "MatchStatus",
      "type": "string"
    },
    "Merge": {
      "additionalProperties": false,
      "description": "Another record folded into this one by deduplication, and why.",
      "properties": {
        "record_id": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
          "title": "Record Id",
          "type": "string"
        },
        "score": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Score",
          "type": "number"
        },
        "reasons": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "minItems": 1,
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "record_id",
        "score",
        "reasons"
      ],
      "title": "Merge",
      "type": "object"
    },
    "MultiLineString": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiLineString",
          "default": "MultiLineString",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiLineString",
      "type": "object"
    },
    "MultiPoint": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiPoint",
          "default": "MultiPoint",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "type": "number"
            },
            "maxItems": 3,
            "minItems": 2,
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPoint",
      "type": "object"
    },
    "MultiPolygon": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "MultiPolygon",
          "default": "MultiPolygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "items": {
                  "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
              },
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "MultiPolygon",
      "type": "object"
    },
    "Point": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "Point",
          "default": "Point",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "type": "number"
          },
          "maxItems": 3,
          "minItems": 2,
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Point",
      "type": "object"
    },
    "Polygon": {
      "additionalProperties": false,
      "description": "Rings of positions: the first is the outer ring, any others are holes.",
      "properties": {
        "type": {
          "const": "Polygon",
          "default": "Polygon",
          "title": "Type",
          "type": "string"
        },
        "coordinates": {
          "items": {
            "items": {
              "items": {
                "type": "number"
              },
              "maxItems": 3,
              "minItems": 2,
              "type": "array"
            },
            "type": "array"
          },
          "title": "Coordinates",
          "type": "array"
        }
      },
      "required": [
        "coordinates"
      ],
      "title": "Polygon",
      "type": "object"
    },
    "RecordStatus": {
      "enum": [
        "resolved",
        "unresolved",
        "conflicting",
        "rejected"
      ],
      "title": "RecordStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "geoproduct/v1",
      "default": "geoproduct/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "title": "Id",
      "type": "string"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "aliases": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "title": "Aliases",
      "type": "array"
    },
    "category": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Category"
    },
    "organisation_id": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Organisation Id"
    },
    "external_ids": {
      "additionalProperties": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "maxLength": 200,
        "minLength": 1
      },
      "title": "External Ids",
      "type": "object"
    },
    "address": {
      "anyOf": [
        {
          "$ref": "#/$defs/Address"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "attributes": {
      "additionalProperties": {
        "$ref": "#/$defs/AttributeValue"
      },
      "propertyNames": {
        "maxLength": 200,
        "minLength": 1
      },
      "title": "Attributes",
      "type": "object"
    },
    "geometry": {
      "anyOf": [
        {
          "discriminator": {
            "mapping": {
              "GeometryCollection": "#/$defs/GeometryCollection",
              "LineString": "#/$defs/LineString",
              "MultiLineString": "#/$defs/MultiLineString",
              "MultiPoint": "#/$defs/MultiPoint",
              "MultiPolygon": "#/$defs/MultiPolygon",
              "Point": "#/$defs/Point",
              "Polygon": "#/$defs/Polygon"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/Point"
            },
            {
              "$ref": "#/$defs/MultiPoint"
            },
            {
              "$ref": "#/$defs/LineString"
            },
            {
              "$ref": "#/$defs/MultiLineString"
            },
            {
              "$ref": "#/$defs/Polygon"
            },
            {
              "$ref": "#/$defs/MultiPolygon"
            },
            {
              "$ref": "#/$defs/GeometryCollection"
            }
          ]
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Geometry"
    },
    "location": {
      "$ref": "#/$defs/Location"
    },
    "building_match": {
      "anyOf": [
        {
          "$ref": "#/$defs/BuildingMatch"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "evidence_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
        "type": "string"
      },
      "title": "Evidence Ids",
      "type": "array"
    },
    "confidence": {
      "anyOf": [
        {
          "$ref": "#/$defs/Confidence"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "status": {
      "$ref": "#/$defs/RecordStatus",
      "default": "unresolved"
    },
    "conflicts": {
      "items": {
        "$ref": "#/$defs/Conflict"
      },
      "title": "Conflicts",
      "type": "array"
    },
    "merged": {
      "items": {
        "$ref": "#/$defs/Merge"
      },
      "title": "Merged",
      "type": "array"
    },
    "limitations": {
      "items": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
      },
      "title": "Limitations",
      "type": "array"
    }
  },
  "required": [
    "id"
  ],
  "title": "Record",
  "type": "object"
}
