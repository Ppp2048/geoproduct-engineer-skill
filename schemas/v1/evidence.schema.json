{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ppp2048/geoproduct-engineer-skill/main/schemas/v1/evidence.schema.json",
  "$defs": {
    "ExcerptCheck": {
      "enum": [
        "verified",
        "not_found",
        "not_checked"
      ],
      "title": "ExcerptCheck",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "A specific piece of a source that supports specific fields of a record.",
  "properties": {
    "schema_version": {
      "const": "geoproduct/v1",
      "default": "geoproduct/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "title": "Id",
      "type": "string"
    },
    "source_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "title": "Source Id",
      "type": "string"
    },
    "supports": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Supports",
      "type": "array"
    },
    "excerpt": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Excerpt"
    },
    "locator": {
      "anyOf": [
        {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Locator"
    },
    "excerpt_check": {
      "$ref": "#/$defs/ExcerptCheck",
      "default": "not_checked"
    },
    "retrieved_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Retrieved At"
    },
    "last_verified": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Last Verified"
    },
    "note": {
      "anyOf": [
        {
          "maxLength": 2000,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Note"
    }
  },
  "required": [
    "id",
    "source_id",
    "supports"
  ],
  "title": "Evidence",
  "type": "object"
}
