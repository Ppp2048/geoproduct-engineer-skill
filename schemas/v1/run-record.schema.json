{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ppp2048/geoproduct-engineer-skill/main/schemas/v1/run-record.schema.json",
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "default": 0,
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "output": {
          "default": 0,
          "minimum": 0,
          "title": "Output",
          "type": "integer"
        },
        "rejected": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        }
      },
      "title": "Counts",
      "type": "object"
    },
    "ErrorCode": {
      "enum": [
        "invalid_input",
        "invalid_spec",
        "unknown_stage",
        "not_found",
        "path_not_allowed",
        "too_large",
        "timeout",
        "cancelled",
        "rate_limited",
        "provider_unavailable",
        "provider_error",
        "policy_refused",
        "auth_missing",
        "capability_unsupported",
        "confirmation_required",
        "quality_gate_failed",
        "stage_failed",
        "internal"
      ],
      "title": "ErrorCode",
      "type": "string"
    },
    "GeoError": {
      "additionalProperties": false,
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "stage": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Stage"
        },
        "retryable": {
          "default": false,
          "title": "Retryable",
          "type": "boolean"
        },
        "details": {
          "additionalProperties": {
            "$ref": "#/$defs/JsonValue"
          },
          "title": "Details",
          "type": "object"
        },
        "hint": {
          "anyOf": [
            {
              "maxLength": 2000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hint"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "GeoError",
      "type": "object"
    },
    "JsonValue": {},
    "Progress": {
      "additionalProperties": false,
      "properties": {
        "done": {
          "minimum": 0,
          "title": "Done",
          "type": "integer"
        },
        "total": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total"
        },
        "message": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Message"
        }
      },
      "required": [
        "done"
      ],
      "title": "Progress",
      "type": "object"
    },
    "RunStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "failed",
        "cancelled"
      ],
      "title": "RunStatus",
      "type": "string"
    },
    "StageState": {
      "additionalProperties": false,
      "properties": {
        "stage_id": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Stage Id",
          "type": "string"
        },
        "uses": {
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
          "title": "Uses",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/StageStatus",
          "default": "pending"
        },
        "attempts": {
          "default": 0,
          "minimum": 0,
          "title": "Attempts",
          "type": "integer"
        },
        "started_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Started At"
        },
        "finished_at": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Finished At"
        },
        "fingerprint": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fingerprint"
        },
        "counts": {
          "$ref": "#/$defs/Counts"
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/Progress"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/GeoError"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "stage_id",
        "uses"
      ],
      "title": "StageState",
      "type": "object"
    },
    "StageStatus": {
      "enum": [
        "pending",
        "running",
        "succeeded",
        "skipped",
        "failed",
        "cancelled"
      ],
      "title": "StageStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "geoproduct/v1",
      "default": "geoproduct/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "pipeline_name": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Pipeline Name",
      "type": "string"
    },
    "spec_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Spec Sha256",
      "type": "string"
    },
    "status": {
      "$ref": "#/$defs/RunStatus",
      "default": "pending"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "started_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Started At"
    },
    "finished_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Finished At"
    },
    "current_stage": {
      "anyOf": [
        {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Current Stage"
    },
    "cancel_requested": {
      "default": false,
      "title": "Cancel Requested",
      "type": "boolean"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageState"
      },
      "title": "Stages",
      "type": "array"
    },
    "versions": {
      "additionalProperties": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
      },
      "propertyNames": {
        "maxLength": 200,
        "minLength": 1
      },
      "title": "Versions",
      "type": "object"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/GeoError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    }
  },
  "required": [
    "run_id",
    "pipeline_name",
    "spec_sha256",
    "created_at",
    "stages"
  ],
  "title": "RunRecord",
  "type": "object"
}
