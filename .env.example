# GeoProduct Engineer settings. Copy the lines you need into your MCP client's "env" block
# or your shell; the server does not read .env files itself. See docs/configuration.md.
# None of these is a secret: the built-in providers need no keys.

# Where sources, datasets, runs and the HTTP cache are stored. Use an absolute path.
GEOPRODUCT_WORKSPACE=/path/to/my-research/.geoproduct

# Further folders tools may read from and export to (";" on Windows, ":" elsewhere).
GEOPRODUCT_ALLOWED_DIRS=

# Required for the public OpenStreetMap services: name your application and a contact.
GEOPRODUCT_USER_AGENT=my-research/0.1 (you@example.org)

# Reuse cached provider responses for this many hours (0 turns the cache off).
GEOPRODUCT_CACHE_TTL_HOURS=168

# Optional: self-hosted services. The rate applies only to a non-public Nominatim.
GEOPRODUCT_NOMINATIM_URL=
GEOPRODUCT_NOMINATIM_RATE=
GEOPRODUCT_OVERPASS_URL=
GEOPRODUCT_OVERPASS_TIMEOUT_S=90
