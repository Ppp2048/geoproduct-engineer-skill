{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ppp2048/geoproduct-engineer-skill/main/schemas/v1/stage-manifest.schema.json",
  "$defs": {
    "Counts": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "default": 0,
          "minimum": 0,
          "title": "Input",
          "type": "integer"
        },
        "output": {
          "default": 0,
          "minimum": 0,
          "title": "Output",
          "type": "integer"
        },
        "rejected": {
          "default": 0,
          "minimum": 0,
          "title": "Rejected",
          "type": "integer"
        }
      },
      "title": "Counts",
      "type": "object"
    },
    "FileRef": {
      "additionalProperties": false,
      "description": "A file written by the engine, with a hash so later runs can verify it is unchanged.",
      "properties": {
        "path": {
          "maxLength": 500,
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "format": {
          "pattern": "^[a-z0-9][a-z0-9.+-]{0,31}$",
          "title": "Format",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 0,
          "title": "Size Bytes",
          "type": "integer"
        },
        "record_count": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Record Count"
        }
      },
      "required": [
        "path",
        "sha256",
        "format",
        "size_bytes"
      ],
      "title": "FileRef",
      "type": "object"
    },
    "JsonValue": {},
    "ProviderUse": {
      "additionalProperties": false,
      "properties": {
        "provider": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "title": "Provider",
          "type": "string"
        },
        "endpoint": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Endpoint"
        },
        "requests": {
          "default": 0,
          "minimum": 0,
          "title": "Requests",
          "type": "integer"
        },
        "cache_hits": {
          "default": 0,
          "minimum": 0,
          "title": "Cache Hits",
          "type": "integer"
        },
        "data_timestamp": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Data Timestamp"
        },
        "licence": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Licence"
        }
      },
      "required": [
        "provider"
      ],
      "title": "ProviderUse",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Written next to a stage's outputs; the checkpoint that makes resuming safe.",
  "properties": {
    "schema_version": {
      "const": "geoproduct/v1",
      "default": "geoproduct/v1",
      "title": "Schema Version",
      "type": "string"
    },
    "run_id": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
      "title": "Run Id",
      "type": "string"
    },
    "stage_id": {
      "pattern": "^[a-z][a-z0-9_-]{0,63}$",
      "title": "Stage Id",
      "type": "string"
    },
    "uses": {
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$",
      "title": "Uses",
      "type": "string"
    },
    "stage_version": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Stage Version",
      "type": "string"
    },
    "fingerprint": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Fingerprint",
      "type": "string"
    },
    "input_fingerprints": {
      "items": {
        "pattern": "^[0-9a-f]{64}$",
        "type": "string"
      },
      "title": "Input Fingerprints",
      "type": "array"
    },
    "params": {
      "additionalProperties": {
        "$ref": "#/$defs/JsonValue"
      },
      "title": "Params",
      "type": "object"
    },
    "outputs": {
      "items": {
        "$ref": "#/$defs/FileRef"
      },
      "title": "Outputs",
      "type": "array"
    },
    "counts": {
      "$ref": "#/$defs/Counts"
    },
    "providers": {
      "items": {
        "$ref": "#/$defs/ProviderUse"
      },
      "title": "Providers",
      "type": "array"
    },
    "source_ids": {
      "items": {
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@-]*$",
        "type": "string"
      },
      "title": "Source Ids",
      "type": "array"
    },
    "started_at": {
      "format": "date-time",
      "title": "Started At",
      "type": "string"
    },
    "finished_at": {
      "format": "date-time",
      "title": "Finished At",
      "type": "string"
    }
  },
  "required": [
    "run_id",
    "stage_id",
    "uses",
    "stage_version",
    "fingerprint",
    "started_at",
    "finished_at"
  ],
  "title": "StageManifest",
  "type": "object"
}
